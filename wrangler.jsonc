{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hmti-inventaris",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  // The deployed origin, and the one host Better Auth trusts in production. Without it the
  // allowlist is empty for a real domain (lib/origins.ts only adds the portal pattern when
  // the configured origin is loopback or unset), so every sign-in on workers.dev fails with
  // INVALID_ORIGIN. Change this if the Worker moves to a custom domain.
  "vars": {
    "BETTER_AUTH_URL": "https://hmti-inventaris.mamangrakai.workers.dev",
  },
  // Custom entrypoint: the framework's default exports only `fetch`, and BR07's cron
  // trigger needs a `scheduled` export. See src/server.ts.
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  // BR07: the H-1 auto-cancel sweep. 17:00 UTC = 00:00 WIB, the plan's "daily at WIB
  // midnight". Cloudflare cron is always UTC, so the offset is load-bearing.
  "triggers": {
    "crons": ["0 17 * * *"],
  },
  // Local dev uses a simulated D1 in .wrangler/state; the id below is the real
  // `hmti-inventaris` database, created with `wrangler d1 create` (decisions.md D1).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hmti-inventaris",
      "database_id": "7677a302-5ead-4836-a462-9fe719b42600",
      "migrations_dir": "drizzle",
    },
  ],
  // Item photos (public) and surat (staff-only) share this bucket under different
  // prefixes; the access rule lives in the Worker, not the bucket (NFR03).
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "hmti-inventaris-files",
    },
  ],
  // Cron triggers land with BR07 (Phase 8). The default TanStack Start entrypoint has
  // no `scheduled` export, so a custom server entry is added at that point — adding one
  // now would be an unverified moving part with nothing to run.
}
