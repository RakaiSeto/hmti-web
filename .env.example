# Copy to .env.local for local dev. Never commit real values.

# Public origin of the app. Local dev default:
BETTER_AUTH_URL=http://localhost:3000

# Better Auth signing secret. Generate one:
#   openssl rand -base64 32
# In production this is a Worker secret, not a file:
#   wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=

# D1 and R2 are bindings, not URLs — they come from wrangler.jsonc, so nothing to set
# here. The local dev database is simulated under .wrangler/state.

# Deferred with the Telegram phase (decisions.md D13):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GROUP_ID=
