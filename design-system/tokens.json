  "contrast": {
    "contract": {
      "brand-on-ink": {
        "pair": [
          "#FFE600",
          "#0A0A0A"
        ],
        "ratio": 15.62,
        "aa": true,
        "aaa": true,
        "use": "The house pair — keep it"
      },
      "brand-on-white": {
        "pair": [
          "#FFE600",
          "#FFFFFF"
        ],
        "ratio": 1.27,
        "aa": false,
        "aaa": false,
        "use": "FORBIDDEN — yellow is a fill, never text on light"
      },
      "accent-on-white": {
        "pair": [
          "#041587",
          "#FFFFFF"
        ],
        "ratio": 14.36,
        "aa": true,
        "aaa": true,
        "use": "Light-mode text, links, actions"
      },
      "accent-on-ink": {
        "pair": [
          "#041587",
          "#0A0A0A"
        ],
        "ratio": 1.38,
        "aa": false,
        "aaa": false,
        "use": "FORBIDDEN in dark mode — use the dark --accent token"
      },
      "tertiary-on-brand": {
        "pair": [
          "#A54105",
          "#FFE600"
        ],
        "ratio": 4.93,
        "aa": true,
        "aaa": false,
        "use": "Large text / strokes only"
      },
      "muted-on-white": {
        "pair": [
          "#737373",
          "#FFFFFF"
        ],
        "ratio": 4.74,
        "aa": true,
        "aaa": false,
        "use": "Passes AA; do not go lighter"
      }
    }
